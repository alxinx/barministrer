MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=barminister
MYSQL_USER=barminister
MYSQL_PASSWORD=barminister
JWT_SECRET=cambia-esto-en-produccion

# Origenes desde los que el navegador puede llamar la API (separados por
# coma). En prod, el dominio publico del frontend; en dev, el puerto de Vite.
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (logo del bar). Cuenta > R2 > Manage API tokens.
# R2_PUBLIC_URL es el dominio publico del bucket (r2.dev o uno propio), sin / al final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=


CLOUDFLARE_SITEKEY=0x4AAAAAAF5a4bSAdbvlLCYW
CLOUDFLARE_SECRETKEY=replace-with-turnstile-secret
